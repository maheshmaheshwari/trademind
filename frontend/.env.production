# Used automatically by `vite build` (production). Safe to commit — these are
# public client-side values, not secrets.
# VITE_BASE_URL is intentionally EMPTY: production API calls are same-origin
# and go through the Vercel proxy function (api/[...path].ts), which adds the
# HF Space token server-side. Never put the Space URL here — the browser
# cannot call the private Space directly.
VITE_BASE_URL=
VITE_USE_MOCK=false
